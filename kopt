#!/usr/bin/env python3
"""Deterministic, conservative optimizer for Kiln IR (KIR).

It deliberately optimizes only operations with no observable effects.  In
particular, it never deletes or moves memory, volatile, or potentially
trapping operations unless a division/modulus is folded with a nonzero
constant divisor.
"""
import argparse
import re
from collections import Counter, defaultdict
from dataclasses import dataclass

MASK = 0xffffffff
REG = re.compile(r"^v(?:0|[1-9][0-9]*)$")
LIT = re.compile(r"^-?(?:0x[0-9a-fA-F]+|[0-9]+)$")
SIG = {
    'const':'di','mov':'ds','add':'dss','sub':'dss','mul':'dss','and':'dss','or':'dss','xor':'dss',
    'shl':'dss','shr':'dss','lt':'dss','eq':'dss','div':'dss','mod':'dss','select':'dsss',
    'mac':'dsss','addsh':'dssk','load':'ds','store':'ss','vload':'ds','vstore':'ss',
    'trap':'s','jmp':'L','br':'sLL','ret':'s'
}
PURE = set(('const','mov','add','sub','mul','and','or','xor','shl','shr','lt','eq','select','mac','addsh'))
TERMS = set(('jmp','br','ret','trap'))
COMMUTATIVE = set(('add','mul','and','or','xor','eq'))

def val(s): return int(s, 0) & MASK
def is_lit(s): return bool(LIT.match(s))
def fmt(n): return str(n & MASK)
def signed(x): return x - (1 << 32) if x & (1 << 31) else x

@dataclass
class Ins:
    op: str
    a: list

@dataclass
class Block:
    label: str
    ins: list

def parse(path):
    name = params = None
    blocks = []
    for raw in open(path, encoding='utf-8-sig').read().splitlines():
        line = raw.split(';',1)[0].strip()
        if not line: continue
        if line.startswith('func '):
            m = re.match(r'^func\s+([A-Za-z_][A-Za-z0-9_]*)\s*\((.*)\)$', line)
            if not m: raise ValueError('invalid function header')
            name, ps = m.groups(); params = [x.strip() for x in ps.split(',') if x.strip()]
        elif line.endswith(':'):
            blocks.append(Block(line[:-1], []))
        else:
            op, *tail = line.split(None, 1)
            if op not in SIG or not blocks: raise ValueError('invalid KIR instruction: ' + line)
            args = [x.strip() for x in tail[0].split(',')] if tail else []
            blocks[-1].ins.append(Ins(op,args))
    if name is None or not blocks: raise ValueError('missing function or blocks')
    return name, params, blocks

def dest(i): return i.a[0] if SIG[i.op][0] == 'd' else None
def uses(i):
    out=[]
    for kind, x in zip(SIG[i.op], i.a):
        if kind == 's' and REG.match(x): out.append(x)
    return out

def successors(blocks):
    ans={b.label:[] for b in blocks}
    for b in blocks:
        t=b.ins[-1]
        if t.op == 'jmp': ans[b.label]=[t.a[0]]
        elif t.op == 'br': ans[b.label]=[t.a[1],t.a[2]]
    return ans

def evalop(op, x):
    # x contains unsigned 32-bit integers.
    if op == 'const' or op == 'mov': return x[0]
    if op == 'add': return (x[0]+x[1]) & MASK
    if op == 'sub': return (x[0]-x[1]) & MASK
    if op == 'mul': return (x[0]*x[1]) & MASK
    if op == 'and': return x[0]&x[1]
    if op == 'or': return x[0]|x[1]
    if op == 'xor': return x[0]^x[1]
    if op == 'shl': return (x[0] << (x[1]&31)) & MASK
    if op == 'shr': return x[0] >> (x[1]&31)
    if op == 'lt': return int(signed(x[0]) < signed(x[1]))
    if op == 'eq': return int(x[0] == x[1])
    if op == 'select': return x[1] if x[0] else x[2]
    if op == 'mac': return (x[0]*x[1]+x[2]) & MASK
    if op == 'addsh': return (x[0] + (x[1] << x[2])) & MASK
    if op == 'div':
        a,b=signed(x[0]),signed(x[1]); return (abs(a)//abs(b) * (-1 if (a<0) != (b<0) else 1)) & MASK
    if op == 'mod':
        a,b=signed(x[0]),signed(x[1]); q=abs(a)//abs(b) * (-1 if (a<0) != (b<0) else 1); return (a-q*b)&MASK
    raise ValueError(op)

def rewrite_block(b):
    """Local constant/copy propagation with indexed invalidation.

    The alias map is kept flat: a newly created copy is first resolved to the
    current source value.  Reverse links let a redefinition invalidate only
    aliases that actually refer to that register, rather than scanning the
    whole environment for every instruction.
    """
    env = {}
    aliases_by_source = defaultdict(set)

    def unbind(reg):
        old = env.pop(reg, None)
        if old is not None:
            aliases_by_source[old].discard(reg)
        # Copies of the old value are no longer valid after this definition.
        for alias in aliases_by_source.pop(reg, ()):
            env.pop(alias, None)

    for i in b.ins:
        sig = SIG[i.op]
        for n, (kind, operand) in enumerate(zip(sig, i.a)):
            if kind == 's' and operand in env:
                i.a[n] = env[operand]
        d = dest(i)
        if d:
            unbind(d)
        values = []
        allconst = True
        for kind, operand in zip(sig, i.a):
            if kind in ('s', 'i', 'k'):
                if is_lit(operand):
                    values.append(val(operand))
                else:
                    allconst = False
                    break
        foldable = i.op in PURE or (i.op in ('div', 'mod') and allconst and values[1] != 0)
        if d and allconst and foldable:
            original_op = i.op
            result = evalop('mov' if original_op == 'const' else original_op, values)
            i.op = 'const'
            i.a = [d, fmt(result)]
        elif d:
            a = i.a
            if i.op == 'mov':
                pass
            elif i.op in ('add', 'or', 'xor') and is_lit(a[2]) and val(a[2]) == 0:
                i.op = 'mov'; i.a = [d, a[1]]
            elif i.op == 'add' and is_lit(a[1]) and val(a[1]) == 0:
                i.op = 'mov'; i.a = [d, a[2]]
            elif i.op == 'sub' and is_lit(a[2]) and val(a[2]) == 0:
                i.op = 'mov'; i.a = [d, a[1]]
            elif i.op == 'mul' and ((is_lit(a[1]) and val(a[1]) == 0) or (is_lit(a[2]) and val(a[2]) == 0)):
                i.op = 'const'; i.a = [d, '0']
            elif i.op == 'mul' and is_lit(a[2]) and val(a[2]) == 1:
                i.op = 'mov'; i.a = [d, a[1]]
            elif i.op == 'mul' and is_lit(a[1]) and val(a[1]) == 1:
                i.op = 'mov'; i.a = [d, a[2]]
            elif i.op == 'and' and ((is_lit(a[1]) and val(a[1]) == 0) or (is_lit(a[2]) and val(a[2]) == 0)):
                i.op = 'const'; i.a = [d, '0']
            elif i.op in ('shl', 'shr') and is_lit(a[2]) and (val(a[2]) & 31) == 0:
                i.op = 'mov'; i.a = [d, a[1]]
            elif i.op in ('eq', 'lt') and a[1] == a[2]:
                same_op = i.op; i.op = 'const'; i.a = [d, '1' if same_op == 'eq' else '0']
            elif i.op == 'select' and a[2] == a[3]:
                i.op = 'mov'; i.a = [d, a[2]]
            elif i.op == 'div' and is_lit(a[2]) and val(a[2]) == 1:
                i.op = 'mov'; i.a = [d, a[1]]
            elif i.op == 'mod' and is_lit(a[2]) and val(a[2]) in (1, MASK):
                i.op = 'const'; i.a = [d, '0']
        if d and i.op == 'const':
            env[d] = i.a[1]
            aliases_by_source[i.a[1]].add(d)
        elif d and i.op == 'mov' and i.a[1] != d:
            env[d] = i.a[1]
            aliases_by_source[i.a[1]].add(d)
    t = b.ins[-1]
    if t.op == 'br' and is_lit(t.a[0]):
        b.ins[-1] = Ins('jmp', [t.a[1] if val(t.a[0]) else t.a[2]])


def _drop_indexed_entry(table, by_operand, by_result, key):
    result = table.pop(key, None)
    if result is None:
        return
    by_result[result].discard(key)
    for operand in key[1:]:
        if REG.match(operand):
            by_operand[operand].discard(key)


def local_cse_and_load_forwarding(blocks):
    """Local CSE/load forwarding with O(total invalidations) cache upkeep."""
    for b in blocks:
        expr = {}
        expr_by_operand = defaultdict(set)
        expr_by_result = defaultdict(set)
        loads = {}
        load_by_operand = defaultdict(set)
        load_by_result = defaultdict(set)

        def kill_load(key):
            result = loads.pop(key, None)
            if result is None:
                return
            load_by_result[result].discard(key)
            for operand in key:
                if REG.match(operand):
                    load_by_operand[operand].discard(key)

        for i in b.ins:
            d = dest(i)
            if d:
                expr_keys = set(expr_by_operand.pop(d, ())) | set(expr_by_result.pop(d, ()))
                for key in expr_keys:
                    _drop_indexed_entry(expr, expr_by_operand, expr_by_result, key)
                load_keys = set(load_by_operand.pop(d, ())) | set(load_by_result.pop(d, ()))
                for key in load_keys:
                    kill_load(key)
            if i.op == 'store':
                loads.clear()
                load_by_operand.clear()
                load_by_result.clear()
                continue
            if i.op == 'load':
                key = tuple(i.a[1:])
                if key in loads:
                    i.op = 'mov'
                    i.a = [i.a[0], loads[key]]
                elif not any(operand == d and REG.match(operand) for operand in key):
                    # A load that overwrites its own address register changes
                    # the meaning of that register for every later load.
                    loads[key] = i.a[0]
                    load_by_result[i.a[0]].add(key)
                    for operand in key:
                        if REG.match(operand):
                            load_by_operand[operand].add(key)
                continue
            if i.op not in PURE or not d:
                continue
            args = tuple(i.a[1:])
            if i.op in COMMUTATIVE:
                args = tuple(sorted(args))
            key = (i.op,) + args
            if key in expr:
                i.op = 'mov'
                i.a = [d, expr[key]]
            elif not any(operand == d and REG.match(operand) for operand in args):
                # Do not cache an expression under an input register that the
                # same instruction just overwrote (KIR is not SSA).
                expr[key] = d
                expr_by_result[d].add(key)
                for operand in args:
                    if REG.match(operand):
                        expr_by_operand[operand].add(key)

def fuse(blocks, machine):
    _, liveout = liveness(blocks)
    for b in blocks:
        last_use = {}
        for pos, ins in enumerate(b.ins):
            for reg in uses(ins):
                last_use[reg] = pos
        out = []; j = 0
        while j < len(b.ins):
            x=b.ins[j]
            if j+1 < len(b.ins):
                y=b.ins[j+1]; td=dest(x)
                if (td and x.op == 'mul' and machine.get('fused_mac',0) and
                    machine.get('lat_mac', 1) <= machine.get('lat_mul', 1) + machine.get('lat_alu', 1) and y.op == 'add' and
                    y.a[1:].count(td)==1 and td not in liveout[b.label] and last_use.get(td, -1) <= j+1):
                    other=y.a[2] if y.a[1]==td else y.a[1]
                    out.append(Ins('mac',[y.a[0],x.a[1],x.a[2],other])); j+=2; continue
                if (td and x.op == 'shl' and machine.get('fused_addsh',0) and
                    machine.get('lat_addsh', 1) <= 2 * machine.get('lat_alu', 1) and is_lit(x.a[2]) and
                    0 <= val(x.a[2]) <= 31 and y.op == 'add' and y.a[1:].count(td)==1 and
                    td not in liveout[b.label] and last_use.get(td, -1) <= j+1):
                    other=y.a[2] if y.a[1]==td else y.a[1]
                    out.append(Ins('addsh',[y.a[0],other,x.a[1],str(val(x.a[2]))])); j+=2; continue
            out.append(x); j+=1
        b.ins=out


def strength_reduce_constants(blocks, mc):
    """Use exact unsigned modular identities when the target makes them win."""
    for b in blocks:
        for i in b.ins:
            if i.op != 'mul': continue
            a,bv=i.a[1],i.a[2]
            c = val(bv) if is_lit(bv) else (val(a) if is_lit(a) else None)
            x = a if is_lit(bv) else bv
            if c is None: continue
            # x * 2^k is exactly x << k in 32-bit modular arithmetic.
            if c and (c & (c-1)) == 0 and mc.get('lat_alu',1) <= mc.get('lat_mul',1):
                i.op='shl'; i.a=[i.a[0],x,str(c.bit_length()-1)]
                continue
            # x * (1 + 2^k) = x + (x << k); addsh is one target instruction.
            q=(c-1) & MASK
            if (mc.get('fused_addsh',0) and c > 1 and q and (q & (q-1)) == 0 and
                q.bit_length()-1 <= 31 and mc.get('lat_addsh',1) <= mc.get('lat_mul',1)):
                i.op='addsh'; i.a=[i.a[0],x,x,str(q.bit_length()-1)]

def liveness(blocks):
    succ=successors(blocks); livein={b.label:set() for b in blocks}; liveout={b.label:set() for b in blocks}
    changed=True
    while changed:
        changed=False
        for b in reversed(blocks):
            out=set().union(*(livein[s] for s in succ[b.label])) if succ[b.label] else set()
            live=set(out)
            for i in reversed(b.ins):
                d=dest(i)
                if d: live.discard(d)
                live.update(uses(i))
            if out != liveout[b.label] or live != livein[b.label]: liveout[b.label]=out; livein[b.label]=live; changed=True
    return livein, liveout

def coalesce_adjacent_copies(blocks):
    """Fold a producer and its sole adjacent copy into one destination."""
    _, liveout = liveness(blocks)
    for b in blocks:
        last_use = {}
        for pos, ins in enumerate(b.ins):
            for reg in uses(ins):
                last_use[reg] = pos
        out = []
        p = 0
        while p < len(b.ins):
            x = b.ins[p]
            if p + 1 < len(b.ins):
                y = b.ins[p + 1]
                tmp = dest(x)
                if (x.op in PURE and tmp and y.op == 'mov' and y.a[1] == tmp and
                        y.a[0] != tmp and tmp not in liveout[b.label] and
                        last_use.get(tmp, -1) <= p + 1):
                    x.a[0] = y.a[0]
                    out.append(x)
                    p += 2
                    continue
            out.append(x)
            p += 1
        b.ins = out

def compact_registers(params, blocks):
    """Colour the global interference graph and reuse virtual register names.

    KIR's spill model charges for *names*, not source-level variable spelling.
    Standard backwards liveness makes it safe to give non-interfering values
    the same name.  Parameters form a clique because their incoming values
    are independently observable at function entry.
    """
    nodes=set(params)
    for b in blocks:
        for i in b.ins:
            if dest(i): nodes.add(dest(i))
            nodes.update(uses(i))
    if not nodes: return params
    livein, out=liveness(blocks)
    # Interference is necessarily dense when many values are simultaneously
    # live.  Since compaction is optional, avoid an unbounded quadratic graph
    # allocation on pathological high-pressure inputs.
    edge_work = 0
    for block in blocks:
        live = set(out[block.label])
        for ins in reversed(block.ins):
            d = dest(ins)
            if d:
                edge_work += len(live)
                if edge_work > 1_500_000:
                    return params
                live.discard(d)
            live.update(uses(ins))
    edges={x:set() for x in nodes}
    def clique(xs):
        xs=sorted(xs, key=lambda z:int(z[1:]))
        for n,x in enumerate(xs):
            for y in xs[n+1:]: edges[x].add(y); edges[y].add(x)
    clique(params)
    # At function entry, parameters hold independent inputs while every
    # non-parameter register holds zero.  Any non-parameter value live before
    # its first definition must therefore interfere with every live parameter.
    entry_live = livein[blocks[0].label]
    for x in entry_live:
        if x not in params:
            for p in params:
                edges[x].add(p)
                edges[p].add(x)
    for b in blocks:
        live=set(out[b.label])
        for i in reversed(b.ins):
            d=dest(i)
            if d:
                for x in live:
                    if x != d: edges[d].add(x); edges[x].add(d)
                live.discard(d)
            # Standard def-vs-live interference construction.  Adding a
            # clique for every live set is both redundant and quadratic in
            # the live-set size at every instruction.
            live.update(uses(i))
    order=sorted(nodes, key=lambda x:(-len(edges[x]), int(x[1:])))
    colour={}
    for x in order:
        forbidden={colour[y] for y in edges[x] if y in colour}; c=0
        while c in forbidden: c+=1
        colour[x]=c
    if len(set(colour.values())) >= len(nodes): return params
    rename={x:'v%d' % colour[x] for x in nodes}
    for b in blocks:
        for i in b.ins:
            for n,(kind,x) in enumerate(zip(SIG[i.op],i.a)):
                if kind in ('d','s') and x in rename: i.a[n]=rename[x]
    return [rename[x] for x in params]

def simple_licm(blocks, mc=None):
    """Hoist pure invariants from canonical two-block loops conservatively.

    A candidate must have exactly one definition in the loop and that
    definition must precede every loop use.  These conditions are essential
    for non-SSA KIR: multiple assignments to one register are not one
    loop-invariant value.
    """
    by = {b.label: b for b in blocks}
    pred = {b.label: [] for b in blocks}
    for source, targets in successors(blocks).items():
        for target in targets:
            pred[target].append(source)
    used = {x for block in blocks for ins in block.ins
            for x in ([dest(ins)] if dest(ins) else []) + uses(ins)}
    next_id = max([int(x[1:]) for x in used] + [-1]) + 1
    latency_profitable_mac = (mc or {}).get('lat_alu', 1) < (mc or {}).get('lat_mac', 1)

    for head in blocks:
        term = head.ins[-1]
        if term.op != 'br':
            continue
        for body_label in term.a[1:]:
            if body_label not in by:
                continue
            body = by[body_label]
            if body.ins[-1].op != 'jmp' or body.ins[-1].a[0] != head.label:
                continue
            if pred[body.label] != [head.label]:
                continue
            pre = [p for p in pred[head.label] if p != body.label]
            if len(pre) != 1 or by[pre[0]].ins[-1].op != 'jmp':
                continue
            preblock = by[pre[0]]
            loop_blocks = (head, body)
            loop_def_counts = Counter(dest(ins) for block in loop_blocks for ins in block.ins if dest(ins))
            outside = [block for block in blocks if block not in loop_blocks]
            outside_uses = {x for block in outside for ins in block.ins for x in uses(ins)}
            head_uses = {x for ins in head.ins for x in uses(ins)}
            invariant = set(x for x in used if loop_def_counts.get(x, 0) == 0)
            moved = []
            body_positions = {id(ins): pos for pos, ins in enumerate(body.ins[:-1])}
            first_body_use = {}
            for pos, ins in enumerate(body.ins[:-1]):
                for reg in uses(ins):
                    first_body_use.setdefault(reg, pos)
            todo = list(body.ins[:-1])
            changed = True
            while changed and todo:
                changed = False
                next_kept = []
                for ins in todo:
                    d = dest(ins)
                    if not (ins.op in PURE and d and loop_def_counts[d] == 1 and
                            d not in outside_uses and d not in head_uses and
                            all(x in invariant for x in uses(ins))):
                        next_kept.append(ins)
                        continue
                    # The value written by this instruction may only be read
                    # after its unique loop definition; it cannot stand in for
                    # an incoming/previous-iteration value.
                    def_pos = body_positions[id(ins)]
                    if first_body_use.get(d, def_pos + 1) <= def_pos:
                        next_kept.append(ins)
                        continue
                    moved.append(ins)
                    invariant.add(d)
                    changed = True
                todo = next_kept
            if not moved:
                continue
            body.ins = todo + [body.ins[-1]]
            preblock.ins[-1:-1] = moved

            # Track every use of a potential MAC temporary across the entire
            # function, not just the remaining suffix of the loop body.
            use_sites = defaultdict(list)
            for block in blocks:
                for ins in block.ins:
                    for reg in uses(ins):
                        use_sites[reg].append(ins)

            transformed = []
            pos = 0
            work = body.ins[:-1]
            while pos < len(work):
                ins = work[pos]
                if (latency_profitable_mac and pos + 1 < len(work) and ins.op == 'mac' and
                        ins.a[1] == ins.a[2] and ins.a[1] in invariant and ins.a[0] != ins.a[3] and
                        work[pos + 1].op == 'add' and work[pos + 1].a[1:].count(ins.a[0]) == 1 and
                        work[pos + 1].a[0] == ins.a[3] and
                        len(use_sites.get(ins.a[0], ())) == 1 and use_sites[ins.a[0]][0] is work[pos + 1]):
                    step = work[pos + 1].a[2] if work[pos + 1].a[1] == ins.a[0] else work[pos + 1].a[1]
                    if step != ins.a[0] and step != ins.a[3]:
                        tmp = 'v%d' % next_id
                        next_id += 1
                        used.add(tmp)
                        invariant.add(tmp)
                        preblock.ins.insert(-1, Ins('mul', [tmp, ins.a[1], ins.a[2]]))
                        transformed.append(Ins('add', [ins.a[3], ins.a[3], tmp]))
                        transformed.append(Ins('add', [ins.a[3], ins.a[3], step]))
                        pos += 2
                        continue
                if (latency_profitable_mac and ins.op == 'mac' and ins.a[1] == ins.a[2] and
                        ins.a[0] == ins.a[3] and ins.a[1] in invariant):
                    tmp = 'v%d' % next_id
                    next_id += 1
                    used.add(tmp)
                    invariant.add(tmp)
                    preblock.ins.insert(-1, Ins('mul', [tmp, ins.a[1], ins.a[2]]))
                    transformed.append(Ins('add', [ins.a[0], ins.a[0], tmp]))
                else:
                    transformed.append(ins)
                pos += 1
            body.ins = transformed + [body.ins[-1]]

def induction_strength_reduce(blocks, mc):
    """Replace signed div/mod for a proved non-negative counting IV only."""
    if mc.get('lat_alu',1) > mc.get('lat_div',1): return
    by={b.label:b for b in blocks}; pred={b.label:[] for b in blocks}
    for a,ts in successors(blocks).items():
        for t in ts: pred[t].append(a)
    for head in blocks:
        term=head.ins[-1]
        if term.op != 'br' or len(head.ins)<2: continue
        cond=term.a[0]; test=next((i for i in head.ins[:-1] if i.op=='lt' and i.a[0]==cond),None)
        if not test: continue
        iv=test.a[1]
        for body_name in term.a[1:]:
            body=by.get(body_name)
            if not body or body.ins[-1].op!='jmp' or body.ins[-1].a[0]!=head.label or pred[body_name] != [head.label]: continue
            pre=[p for p in pred[head.label] if p != body_name]
            if len(pre)!=1 or by[pre[0]].ins[-1].op!='jmp': continue

def machine(path):
    d={}
    for raw in open(path, encoding='utf-8-sig'):
        line=raw.split('#',1)[0].strip()
        if '=' in line:
            k,v=line.split('=',1); d[k.strip()]=int(v.strip())
    return d

def emit(name, params, blocks, out):
    lines=['func %s(%s)' % (name, ', '.join(params))]
